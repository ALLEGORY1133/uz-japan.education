# Nusxa oling: cp .env.example .env
POSTGRES_DB=uzjapan
POSTGRES_USER=uzjapan
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
SEED_DEMO=1
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345

# Portlar band bo'lsa o'zgartiring (o'zgartirsangiz yuqoridagi URL'larni ham moslang)
# BACKEND_PORT=8010
# WEB_PORT=3010
# ADMIN_PORT=3011
# PUBLIC_API_URL=http://localhost:8010
# PUBLIC_WEB_URL=http://localhost:3010
# CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3011

# Fayllarni virusga tekshirish (ClamAV): xavfsizlik uchun 1. Skaner ishlamasa fayl qabul qilinmaydi.
# Skanerni butunlay o'chirish (faqat sinov uchun): CLAMAV_HOST= (bo'sh)
CLAMAV_REQUIRED=1

# --- Parolni tiklash (email) ---
# Standart: xat docker loglariga chiqadi (docker compose logs backend). Haqiqiy yuborish uchun SMTP kiriting:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=sizning@gmail.com
# EMAIL_HOST_PASSWORD=ilova-paroli
# DEFAULT_FROM_EMAIL=UzJapan Education <sizning@gmail.com>
PUBLIC_ADMIN_URL=http://127.0.0.1:3011
# CABINET_REQUIRE_CODE=1   # 1 — kabinetga kirishda emailga bir martalik kod yuboriladi (xavfsizroq)
